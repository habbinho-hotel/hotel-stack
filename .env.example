# Copiado para .env pelo ./setup.sh (as senhas são geradas na hora).

# Endereço pelo qual VOCÊ abre o hotel no navegador.
# Local: localhost. Rede local: o IP da máquina (e BIND_ADDR=0.0.0.0).
HOTEL_HOST=localhost
BIND_ADDR=127.0.0.1

# Portas publicadas no host
HTTP_PORT=8080
EMU_PORT=2096

# Fuso do hotel e do banco (nome IANA, ex.: America/Sao_Paulo)
TZ=UTC

# Memória da JVM do Polaris
JAVA_OPTS=-Xmx2g

# Banco
DB_NAME=habbo
DB_USER=polaris
DB_ROOT_PASSWORD=troque-me
DB_PASSWORD=troque-me

# HabboAssets API pública (https://www.habboassets.com/api)
# Mescla badges e sons do espelho em gamedata/ ao rodar ./setup.sh.
# Exige rede; deixe 0 para pular e manter o setup rápido.
HABBO_ASSETS=0
# Hotel da HabboAssets (1 = Habbo.com). Só usado quando HABBO_ASSETS=1.
HABBO_HOTEL_ID=1
