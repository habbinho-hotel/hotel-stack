# HOTEL_DYNAMIC_RANGE=172.30.89.128/25
# JAVA_OPTS=-Xmx2g
# TZ=UTC
# MARIADB_IMAGE=mariadb:11.4
# CADDY_IMAGE=caddy:2-alpine
